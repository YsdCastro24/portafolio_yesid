---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/cv.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    background: #fff;
    letter-spacing: -0.025rem;
  }

  body {
    margin: 0;
    padding: 0;
    max-width: 100%;
    overflow-x: hidden;
  }

  main {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    padding: 4rem 1rem;
  }

  h1,
  h2,
  h3,
  h4 {
    margin-bottom: 1rem;
    font-weight: 600;
  }

  p {
    color: #555;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  /* Ajustes para tablets y móviles */
  @media (max-width: 768px) {
    main {
      width: 95%;
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 1.8rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    p {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.5rem;
      text-align: center;
    }

    h2 {
      font-size: 1.3rem;
    }

    p {
      font-size: 0.85rem;
    }
  }

  @media print {
    .section {
      page-break-inside: avoid;
    }
    li {
      page-break-inside: avoid;
    }
    h2 {
      page-break-after: avoid;
    }
  }

  @media print {
    .no-print {
      display: none;
    }
  }
</style>
