---
import Section from "../Section.astro";
import { work } from "@cv";
---

<Section title="Experiencia laboral">
    <ul>
        {
            work.map(({ name, startDate, endDate, position, summary }) => {
                const startYear = new Date(startDate).getFullYear();
                const currentYear = new Date().getFullYear();
                const endYear = endDate ? new Date(endDate).getFullYear() : currentYear;
                const years = `${startYear} - ${endYear === currentYear ? "Actual" : endYear}`;

                return (
                    <li class="experience-item">
                        <article>
                            <header>
                                <div>
                                    <h3>{name}</h3>
                                    <h4>{position}</h4>
                                </div>
                                <time>{years}</time>
                            </header>
                            <footer>
                                <p>{summary}</p>
                            </footer>
                        </article>
                    </li>
                );
            })
        }
    </ul>
</Section>

<style>
	.section {
		padding: 4rem 0;
		max-width: 800px;
		margin: auto;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding: 0;
	}

	li {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	article h3 {
		font-size: 1.4rem;
		font-weight: 600;
		color: #111;
	}

	article h4 {
		font-size: 1.2rem;
		color: #444;
		font-weight: 500;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 8px;
	}

	time {
		color: #666;
		font-size: 0.9rem;
	}

	/* Responsivo */
	@media (max-width: 768px) {
		header {
			flex-direction: column;
		}

		time {
			margin-top: 4px;
			font-size: 0.8rem;
		}

		article h3 {
			font-size: 1.2rem;
		}

		article h4 {
			font-size: 1rem;
		}
	}

	@media (max-width: 480px) {
		.section {
			padding: 2rem 0;
		}

		article h3 {
			font-size: 1.1rem;
		}

		article h4 {
			font-size: 0.95rem;
		}
	}
</style>

