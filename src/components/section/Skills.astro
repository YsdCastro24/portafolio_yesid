---
import Section from "../Section.astro"

import { skills } from '@cv'
---

<Section title="Skills">
    <ul>
        {

            skills.map(({ name }) => (
                <li>
                    <span>{name}</span>
                </li>
            ))
        }
    </ul>
</Section>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center; /* Centra las habilidades */
        padding: 0;
        margin-top: 1rem;
    }

    li {
        border-radius: 6px;
        background: #eee;
        color: black;
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
        text-align: center;
        white-space: nowrap;
    }

    /* Responsivo */
    @media (max-width: 768px) {
        li {
            font-size: 0.8rem;
            padding: 0.3rem 0.6rem;
        }
    }

    @media (max-width: 480px) {
        ul {
            gap: 6px;
        }

        li {
            font-size: 0.75rem;
            padding: 0.3rem 0.5rem;
        }
    }
</style>

