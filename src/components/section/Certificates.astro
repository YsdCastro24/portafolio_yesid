---
import Section from "../Section.astro";
import { certificates } from "@cv";
---

<Section title="Certificados">
  <ul>
    {
      certificates.map(({ name, date, issuer }) => {
        const formattedDate = new Date(date).toLocaleDateString("es-ES", {
          year: "numeric",
          month: "long",
        });

        return (
          <li>
            <article>
              <h3>{name}</h3>
              <p>{issuer}</p>
              <time>{formattedDate}</time>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  article {
    border-left: 4px solid #007acc;
    padding-left: 12px;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: bold;
  }

  p {
    color: #444;
    font-size: 1rem;
  }

  time {
    color: #666;
    font-size: 0.9rem;
  }
</style>
